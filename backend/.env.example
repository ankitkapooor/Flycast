DATA_DIR=/data

CONNECTOME_VERSION=male-cns:v1.0

CONNECTOME_SIGN_MODE=unsigned

CONNECTOME_SEED=42

INPUT_NEURONS=512

READOUT_NEURONS=4096

RESERVOIR_LEAK=0.25

RESERVOIR_GAIN=0.95

INPUT_GAIN=0.5

MAX_SIMULATION_STEPS=1000

MAX_UPLOAD_MB=5

MAX_CONCURRENT_JOBS=1

EXPERIMENT_TTL_HOURS=24

ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

# Set to true for rapid local testing without downloading 1.1GB MaleCNS connectome
USE_FIXTURE_BRAIN=false

# Set to true only if fallback to synthetic fixture is permitted when real MaleCNS download/build fails
ALLOW_FIXTURE_FALLBACK=false
